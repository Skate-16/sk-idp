<%- include('partials/header') %>
<section class="topbar">
  <div>
    <h1>Provision Service</h1>
    <p>Creates app code, Dockerfile, Kubernetes YAML, Terraform and Jenkinsfile.</p>
  </div>
</section>

<% if (errors.length) { %>
  <div class="alert">
    <% errors.forEach(error => { %><p><%= error %></p><% }) %>
  </div>
<% } %>

<form class="form" method="post" action="/provision">
  <label>Service name
    <input name="name" required placeholder="payment-api" value="<%= values.name || '' %>">
  </label>
  <label>Owner email
    <input name="owner" required placeholder="dev@company.com" value="<%= values.owner || '' %>">
  </label>
  <label>Docker Hub username
    <input name="dockerHubUser" required placeholder="yourdockerhubname" value="<%= values.dockerHubUser || '' %>">
  </label>
  <label>Template
    <select name="template">
      <option value="node-api" <%= values.template === 'node-api' ? 'selected' : '' %>>Node API</option>
      <option value="static-web" <%= values.template === 'static-web' ? 'selected' : '' %>>Static web</option>
      <option value="worker" <%= values.template === 'worker' ? 'selected' : '' %>>Worker</option>
    </select>
  </label>
  <label>Environment
    <select name="env">
      <option value="dev" <%= values.env === 'dev' ? 'selected' : '' %>>dev</option>
      <option value="stage" <%= values.env === 'stage' ? 'selected' : '' %>>stage</option>
      <option value="prod" <%= values.env === 'prod' ? 'selected' : '' %>>prod</option>
    </select>
  </label>
  <label>Replicas
    <input name="replicas" type="number" min="1" max="3" value="<%= values.replicas || 1 %>">
  </label>
  <label>Cost center
    <input name="costCenter" value="<%= values.costCenter || 'learning' %>">
  </label>
  <button class="button" type="submit">Create service</button>
</form>
<%- include('partials/footer') %>
